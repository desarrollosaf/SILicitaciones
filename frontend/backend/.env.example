# DB_HOST segun donde este el servidor:
#   host.docker.internal  MySQL en esta misma maquina y el backend en Docker
#   mysql                  MySQL del propio docker-compose.yml (servicio "mysql")
#   localhost              MySQL en esta misma maquina y el backend con npm
DB_HOST=localhost
DB_PORT=3306
DB_USER=licitaciones
DB_PASSWORD=licitaciones
DB_NAME=licitaciones
# DB_SYNC=true sincroniza el esquema automaticamente: util en desarrollo, pero
# en produccion debe quedar en false para no alterar la base sin control.
DB_SYNC=true
PORT=3000
CORS_ORIGIN=http://localhost:4200
